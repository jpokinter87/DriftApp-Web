  "components": [
    {
      "name": "Bouton principal",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Action principale d'un panneau (Ouvrir, Démarrer le suivi).",
      "html": "<button class=\"ds-btn-primary\">Ouvrir</button>",
      "css": ".ds-btn-primary{background:#d4a055;color:#1a1612;font-family:'JetBrains Mono','SF Mono',ui-monospace,monospace;font-size:14px;font-weight:600;padding:8px 16px;border:none;border-radius:8px;cursor:pointer;transition:all .2s}.ds-btn-primary:hover{background:#e8b870}.ds-btn-primary:focus-visible{outline:2px solid #d4a055;outline-offset:2px}.ds-btn-primary:disabled{opacity:.5;cursor:not-allowed}"
    },
    {
      "name": "Bouton secondaire",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Bouton par défaut (Rechercher, Fermer, GOTO).",
      "html": "<button class=\"ds-btn-secondary\">Rechercher</button>",
      "css": ".ds-btn-secondary{background:#2d261e;color:#e8e4df;border:1px solid #4a3d2e;font-family:'JetBrains Mono','SF Mono',ui-monospace,monospace;font-size:14px;font-weight:500;padding:8px 16px;border-radius:8px;cursor:pointer;transition:all .2s}.ds-btn-secondary:hover{background:#3d3428}.ds-btn-secondary:focus-visible{outline:2px solid #d4a055;outline-offset:2px}"
    },
    {
      "name": "Bouton STOP",
      "kind": "button",
      "refersTo": "button-stop",
      "description": "Arrêt immédiat, halo rouge permanent ; même traitement pour le parking.",
      "html": "<button class=\"ds-btn-stop\">STOP</button>",
      "css": ".ds-btn-stop{background:rgba(255,71,87,.2);color:#ff4757;font-family:'JetBrains Mono','SF Mono',ui-monospace,monospace;font-size:14px;font-weight:700;padding:12px 32px;border:none;border-radius:8px;cursor:pointer;box-shadow:0 0 8px rgba(255,71,87,.4),0 0 20px rgba(255,71,87,.15);transition:all .2s}.ds-btn-stop:hover{background:rgba(255,71,87,.3)}.ds-btn-stop:focus-visible{outline:2px solid #d4a055;outline-offset:2px}"
    },
    {
      "name": "Rangée JOG",
      "kind": "custom",
      "refersTo": "button-jog",
      "description": "Boutons de déplacement manuel, largeur égale, cibles tactiles.",
      "html": "<div class=\"ds-jog-row\"><button class=\"ds-btn-jog\">&lt; CCW</button><button class=\"ds-btn-jog\">-10°</button><button class=\"ds-btn-jog\">-1°</button><button class=\"ds-btn-jog\">+1°</button><button class=\"ds-btn-jog\">+10°</button><button class=\"ds-btn-jog\">CW &gt;</button></div>",
      "css": ".ds-jog-row{display:flex;gap:8px}.ds-btn-jog{flex:1;padding:12px 0;background:#2d261e;color:#e8e4df;border:1px solid #4a3d2e;border-radius:8px;font-family:'JetBrains Mono','SF Mono',ui-monospace,monospace;font-size:14px;cursor:pointer;transition:all .2s}.ds-btn-jog:hover{background:#3d3428}.ds-btn-jog:focus-visible{outline:2px solid #d4a055;outline-offset:2px}"
    },
    {
      "name": "Champ de saisie",
      "kind": "input",
      "refersTo": "input-field",
      "description": "Recherche d'objet, azimut GOTO.",
      "html": "<input class=\"ds-input\" placeholder=\"Ex: M31, Vega, Jupiter...\">",
      "css": ".ds-input{width:100%;padding:8px 12px;background:#2d261e;border:1px solid #4a3d2e;border-radius:8px;color:#e8e4df;font-family:'JetBrains Mono','SF Mono',ui-monospace,monospace;font-size:14px;outline:none;transition:border-color .2s}.ds-input::placeholder{color:#706050}.ds-input:focus{border-color:#d4a055}"
    },
    {
      "name": "Navigation d'en-tête",
      "kind": "nav",
      "refersTo": "tab-item-active",
      "description": "Onglets de pages dans l'en-tête collant.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-nav-tab is-active\">Controle</a><a class=\"ds-nav-tab\">Systeme</a><a class=\"ds-nav-tab\">Session</a><a class=\"ds-nav-tab\">Configuration</a></nav>",
      "css": ".ds-nav{display:flex;gap:4px;background:#241e18;padding:8px}.ds-nav-tab{padding:6px 12px;border-radius:8px;font-family:'IBM Plex Sans',system-ui,sans-serif;font-size:14px;font-weight:500;color:#a09080;cursor:pointer;transition:color .2s,background .2s}.ds-nav-tab:hover{color:#e8e4df;background:#3d3428}.ds-nav-tab.is-active{background:rgba(212,160,85,.15);color:#d4a055}"
    },
    {
      "name": "Badges d'état",
      "kind": "chip",
      "refersTo": "badge-amber",
      "description": "État d'un service ou d'un capteur, couleur = sens.",
      "html": "<span class=\"ds-badge ds-ok\">SEC</span> <span class=\"ds-badge ds-warn\">STALE</span> <span class=\"ds-badge ds-err\">UNAVAILABLE</span> <span class=\"ds-badge ds-amber\">FERMÉ</span>",
      "css": ".ds-badge{display:inline-flex;align-items:center;padding:2px 8px;border-radius:6px;font-family:'JetBrains Mono','SF Mono',ui-monospace,monospace;font-size:12px;font-weight:500}.ds-ok{background:rgba(0,210,106,.15);color:#00d26a}.ds-warn{background:rgba(255,165,2,.15);color:#ffa502}.ds-err{background:rgba(255,71,87,.15);color:#ff4757}.ds-amber{background:rgba(212,160,85,.15);color:#d4a055}"
    },
    {
      "name": "Panneau constellé",
      "kind": "card",
      "refersTo": "panel",
      "description": "Panneau principal avec titre en dégradé feu et case d'information.",
      "html": "<section class=\"ds-panel\"><h2 class=\"ds-title\">Position Coupole</h2><div class=\"ds-info\"><span class=\"ds-info-label\">ENC :</span><span class=\"ds-info-value\">0.00°</span></div></section>",
      "css": ".ds-panel{background:#241e18;border:1px solid #4a3d2e;border-radius:10px;padding:16px;box-shadow:0 2px 8px rgba(0,0,0,.3),0 1px 3px rgba(0,0,0,.2);transition:box-shadow .3s}.ds-panel:hover{box-shadow:0 0 15px rgba(212,160,85,.15),0 0 30px rgba(212,160,85,.05)}.ds-title{display:inline-block;width:fit-content;margin:0 0 12px;font-family:'JetBrains Mono','SF Mono',ui-monospace,monospace;font-size:16px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;background:linear-gradient(90deg,#ff6b00 0%,#ff8c00 30%,#ffa500 50%,#d4a055 80%,#c09050 100%);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;color:transparent}.ds-info{display:flex;justify-content:space-between;padding:8px;background:#2d261e;border-radius:8px;font-family:'JetBrains Mono','SF Mono',ui-monospace,monospace;font-size:12px}.ds-info-label{color:#706050;text-transform:uppercase;letter-spacing:.025em}.ds-info-value{color:#e8e4df;font-weight:700}"
    }
  ],
  "narrative": {
    "northStar": "La salle de veille",
    "overview": "\n**Creative North Star: \"La salle de veille\"**\n\nDriftApp ressemble à un poste de contrôle de nuit. Les surfaces sont en bois sombre et en bronze. La seule lumière chaude est l'ambre d'une lanterne, et les voyants ne s'allument que lorsqu'ils ont quelque chose à dire. Tout est posé sur un fond brun presque noir, jamais sur du gris neutre ni du bleu d'application. Les panneaux, les champs et les survols sont de simples paliers de ce même bois, chacun un peu plus clair que le précédent. La couleur vive est réservée aux états : vert pour un suivi actif ou un service en marche, orange pour une attente ou un avertissement, rouge pour STOP et l'alarme, ambre pour l'action principale et la marque.\n\nL'écriture est celle d'un instrument. JetBrains Mono sert aux titres, aux boutons, aux valeurs et aux journaux ; IBM Plex Sans ne porte que le texte courant. Les titres de section sont en capitales, avec un dégradé « feu » qui va de l'orange vif à l'ambre. Un motif de constellations très discret tapisse les grands panneaux. La boussole est la seule zone froide : un disque bleu nuit qui figure le ciel au milieu du bois.\n\nL'écran est dense, mais chaque bloc répond à une seule question (où est la coupole, que suit-on, comment reprendre la main, dans quel état est le cimier, que s'est-il passé). Ce sont les halos et les pulsations qui signalent les états vivants, bien plus que la typographie.",
